{
  "name": "repair-hub",
  "type": "module",
  "private": true,
  "workspaces": [
    "backend",
    "classic-frontend"
  ],
  "scripts": {
    "dev": "npm run dev:classic",
    "dev:backend": "npm --workspace backend run dev",
    "dev:classic": "npx vite --config vite.config.ts",
    "build": "npm run build:backend && npm run build:classic",
    "build:backend": "npm --workspace backend run build",
    "build:classic": "npx vite build --config vite.config.ts",
    "preview:classic": "npx vite preview --config vite.config.ts --host 0.0.0.0 --port 3000",
    "test": "npm run test:backend",
    "test:backend": "npm --workspace backend test",
    "race:test": "node scripts/race-test.mjs"
  }
}
